using FluentValidation;
using {{name_space}}.Services{{module_name}}Svc.Dtos;

namespace {{name_space}}.Api.Validators{{module_name}};

/// <summary>
/// {{table_comment ?? table_cs_name}}验证器
/// </summary>
public class {{table_cs_name}}InputValidator : AbstractValidator<{{table_cs_name}}Input>
{
    /// <summary>
    /// Validator
    /// </summary>
    public {{table_cs_name}}InputValidator()
    {   
{{- for col in columns -}}
{{ if col.cs_type_name == "String" && col.max_length > 0 && col.cs_name != "Id" && col.cs_name != "CreatorUserId" && col.cs_name != "CreatorUserName" && col.cs_name != "LastModifierUserId" && col.cs_name != "LastModifierUserName" && col.cs_name != "IsDeleted" }}
        RuleFor(x => x.{{col.cs_name}}).MaximumLength({{col.max_length}}).WithMessage("{{(col.comment == empty || col.comment == null) ? col.cs_name : col.comment }}长度不能超过{{col.max_length}}个字符");  
{{- end }}
{{- if !col.is_nullable && col.cs_name != "Id" && col.cs_name != "CreatorUserId" && col.cs_name != "CreatorUserName" && col.cs_name != "LastModifierUserId" && col.cs_name != "LastModifierUserName" && col.cs_name != "CreationTime" && col.cs_name != "LastModificationTime" && col.cs_name != "IsDeleted" }}
        RuleFor(x => x.{{col.cs_name}}).NotEmpty().WithMessage("{{(col.comment == empty || col.comment == null) ? col.cs_name : col.comment }}不能为空");
{{- end }}
{{- end }}
    }
}
